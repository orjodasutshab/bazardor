# Copy this file to .env.local and fill in your own values.
# Never commit real secrets to GitHub.

# Secret key that protects login sessions.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# The site's address (use http://localhost:3000 when running locally)
BETTER_AUTH_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=

# Optional: address of the products API (a default is used if empty)
NEXT_PUBLIC_API_URL=https://openapi.programming-hero.com/api/bazardor

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
